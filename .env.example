# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — DO NOT prefix with NEXT_PUBLIC_. Optional: only needed if
# your RLS policy does not allow anon SELECT on `submissions` for export.
# If you leave this unset, the export route falls back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=
